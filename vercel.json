{
"builds": [
{
"src": "frontend/index.html",
"use": "@vercel/static"
},
{
"src": "backend/main.py",
"use": "@vercel/python"
}
],
"routes": [
{
"src": "/predict_price",
"dest": "/backend/main.py"
},
{
"src": "/docs(.)",
"dest": "/backend/main.py"
},
{
"src": "/openapi.json",
"dest": "/backend/main.py"
},
{
"src": "/(.)",
"dest": "/frontend/index.html"
}
]
}